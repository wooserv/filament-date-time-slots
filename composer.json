{
    "name": "wooserv/filament-date-time-slots",
    "description": "A Filament date-time picker with configurable calendars, working hours, available slots, and booking constraints.",
    "homepage": "https://github.com/wooserv/filament-date-time-slots",
    "support": {
        "issues": "https://github.com/wooserv/filament-date-time-slots/issues",
        "source": "https://github.com/wooserv/filament-date-time-slots"
    },
    "authors": [
        {
            "name": "WooServ Team",
            "email": "contact@wooserv.com",
            "role": "Developer"
        },
        {
            "name": "Hamada Habib",
            "email": "ihfbib@wooserv.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "wooserv",
        "laravel",
        "date-time-slots",
        "filament-plugin",
        "time-slots"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2|^4.0|^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "WooServ\\FilamentDateTimeSlots\\": "src/",
            "WooServ\\FilamentDateTimeSlots\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooServ\\FilamentDateTimeSlots\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "WooServ\\FilamentDateTimeSlots\\DateTimeSlotPickerServiceProvider"
            ]
        }
    }
}